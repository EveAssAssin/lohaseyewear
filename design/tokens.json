        { "name": "err", "value": "#A85A4A", "desc": "錯誤訊息(柔和)、登出" },
        { "name": "err-bg", "value": "#F5E8E4", "desc": "錯誤的淡底" },
        { "name": "err-strong", "value": "#794035", "desc": "錯誤的深字:放在 err-bg 上(對比 6.8)" },
        { "name": "err-line", "value": "#E5C5C5", "desc": "錯誤、駁回、刪除鈕的淡紅邊線" },
        { "name": "danger", "value": "#C0392B", "desc": "刪除、無法復原的動作(按鈕、確認框)" },
        { "name": "danger-bg", "value": "#FDEDEC", "desc": "危險動作的淡底" },
        { "name": "danger-strong", "value": "#8D2B20", "desc": "危險的深字:放在 danger-bg 上(對比 7.4)" },
        { "name": "info", "value": "#4D6B89", "desc": "資訊、說明、即將開始、處理中(柔和的藍,配合品牌暖色)" },
        { "name": "info-bg", "value": "#EBF0F4", "desc": "資訊的淡底" },
        { "name": "info-strong", "value": "#3B5268", "desc": "資訊的深字:放在 info-bg 上(對比 7.1)" },
        { "name": "favorite", "value": "#C85F5F", "desc": "收藏、喜歡" },
        { "name": "notify", "value": "#E5484D", "desc": "未讀紅點" }
      ]
    },
    {
      "id": "gold", "title": "金色系(創作者分潤、星星皇冠)", "type": "color",
      "tokens": [
