        { "name": "ai-bg", "value": "#F3EEF7", "desc": "AI 的淡底:對話泡泡、提示區" },
        { "name": "ai-strong", "value": "#5B3B72", "desc": "AI 的深字:放在 ai-bg 上(對比 8.0)" }
