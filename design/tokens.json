{
  "$schema": "LOHAS design tokens · 正本(唯一來源)。改這裡,然後跑 node design/build.mjs",
  "name": "LOHAS 樂活眼鏡 Design Tokens",
  "version": "1.1.0",
  "updated": "2026-11-24",
  "homepage": "https://www.lohasglasses.com/design/",
  "rules": [
    "v1 只會「新增」token,不改、不刪既有的值;要改值或刪除就出 v2(新資料夾)",
    "文字色 token 只用在文字、邊框色只用在邊框、底色只用在背景 —— 值剛好一樣也不要混用",
    "不要寫純灰(#333、#666、#888、#999),品牌是暖色系,用 text-* token",
    "全站最小字級 12px;手機上的輸入框至少 16px(iOS 小於 16px 會放大整頁)",
    "狀態標籤「淡底配字」:底用 *-bg、字用 *-strong;原色(ok / warn / err / info)用在白底上的圖示、邊框、大字"
  ],
  "groups": [
    {
      "id": "brand", "title": "品牌色", "type": "color",
      "tokens": [
        { "name": "lohas-brand", "value": "#50422D", "desc": "主色:主要按鈕、標題強調、連結" },
        { "name": "lohas-hover", "value": "#765F4A", "desc": "主色 hover / 按下" },
        { "name": "lohas-light", "value": "#CDBEA2", "desc": "淡棕:虛線框、次要裝飾" },
        { "name": "lohas-bd", "value": "#E8DED1", "desc": "所有邊框、分隔線" }
      ]
    },
    {
      "id": "background", "title": "底色", "type": "color",
      "tokens": [
        { "name": "bg-warm", "value": "#F9F8F6", "desc": "區塊底色" },
        { "name": "bg-soft", "value": "#F4F1EC", "desc": "卡片內底、hover 底" },
        { "name": "bg-cream", "value": "#FAF7F2", "desc": "米白底:表單區、提示區" },
        { "name": "bg-white", "value": "#FFFFFF", "desc": "白底:卡片、表格、輸入框、彈窗(白色當底色用這個,不要借 text-on-dark)" }
      ]
    },
    {
      "id": "text", "title": "文字色", "type": "color",
      "tokens": [
        { "name": "text-main", "value": "#2F2A24", "desc": "主文字" },
        { "name": "text-sub", "value": "#6F665D", "desc": "次要文字、欄位標籤" },
        { "name": "text-muted", "value": "#9B9186", "desc": "註記、placeholder" },
        { "name": "text-light", "value": "#CDBEA2", "desc": "很淡的文字、停用的圖示" },
        { "name": "text-disabled", "value": "#8A8178", "desc": "已使用 / 已過期這類「不能再用」的文字" },
        { "name": "text-on-dark", "value": "#FFFFFF", "desc": "深色底上的字" }
      ]
    },
    {
      "id": "identity", "title": "身份色(會員 / 創作者 / 聯名)", "type": "color",
      "tokens": [
        { "name": "m-bg", "value": "#E8E5E0", "desc": "會員標籤底色(灰米)" },
        { "name": "m-text", "value": "#3D3D3D", "desc": "會員標籤文字" },
        { "name": "c-bg", "value": "#EFE9F5", "desc": "創作者淡紫底" },
        { "name": "c-text", "value": "#6B5887", "desc": "創作者紫字" },
        { "name": "c-solid", "value": "#6B5887", "desc": "創作者實色(標籤底)" },
        { "name": "c-line", "value": "#D5C7E5", "desc": "創作者紫的邊線" },
        { "name": "c-line-strong", "value": "#C5B5DC", "desc": "創作者紫的強調邊線(虛線框)" },
        { "name": "collab-bg", "value": "#3D2F2C", "desc": "聯名深棕底" },
        { "name": "collab-bg-2", "value": "#2D2520", "desc": "聯名更深的棕(漸層另一端)" },
        { "name": "collab-gold", "value": "#D4B068", "desc": "聯名金邊" }
      ]
    },
    {
      "id": "status", "title": "狀態色", "type": "color",
      "tokens": [
        { "name": "ok", "value": "#5F7A5A", "desc": "成功、完成" },
        { "name": "ok-bg", "value": "#EEF1EC", "desc": "成功的淡底" },
        { "name": "ok-strong", "value": "#495E45", "desc": "成功的深字:放在 ok-bg 上(對比 6.2)" },
        { "name": "warn", "value": "#B58A42", "desc": "警告、待處理(白底上對比只有 3.1,用在圖示、邊框、大字)" },
        { "name": "warn-bg", "value": "#F8F1E1", "desc": "警告的淡底" },
